{
  "schema": 1,
  "manifestVersion": "2026.10.25",
  "id": "dispatcharr-modular",
  "name": "Dispatcharr (modular)",
  "variantOf": "dispatcharr",
  "variant": {
    "label": "Modular",
    "reason": "Separate web, worker, PostgreSQL and Valkey containers (the official modular compose) instead of the all-in-one image. For larger installations."
  },
  "category": "media",
  "group": "C",
  "description": "Advanced: Dispatcharr with separate web and worker containers, PostgreSQL 17 and a Valkey cache, following the official modular compose.",
  "maintainer": "Dispatcharr contributors",
  "license": "AGPL-3.0",
  "source": {
    "type": "curated",
    "url": "https://github.com/Dispatcharr/Dispatcharr"
  },
  "docs": [
    {
      "title": "Modular compose",
      "url": "https://github.com/Dispatcharr/Dispatcharr/blob/v0.32.0/docker/docker-compose.yml"
    }
  ],
  "platforms": {
    "windows-docker-desktop": "supported",
    "linux-docker": "untested",
    "unraid": "untested",
    "podman": "untested"
  },
  "architectures": [
    "amd64",
    "arm64"
  ],
  "installable": true,
  "services": {
    "web": {
      "image": "ghcr.io/dispatcharr/dispatcharr:0.32.0@sha256:b7d695c5cc98b9abd64c74a94539c1ebffc23d965021613c820c67e25dea41a3",
      "role": "app",
      "label": "Dispatcharr web",
      "ports": [
        {
          "container": 9191,
          "protocol": "http",
          "primary": true
        }
      ],
      "environment": {
        "DISPATCHARR_ENV": "modular",
        "POSTGRES_HOST": "db",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "dispatcharr",
        "POSTGRES_USER": "dispatch",
        "POSTGRES_PASSWORD": "{{input:dbPassword}}",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "DISPATCHARR_LOG_LEVEL": "info",
        "TZ": "{{timezone}}"
      },
      "volumes": [
        {
          "name": "data",
          "target": "/data",
          "kind": "volume",
          "description": "Settings and recordings."
        }
      ],
      "dependsOn": [
        {
          "service": "db",
          "condition": "service_healthy"
        },
        {
          "service": "redis",
          "condition": "service_healthy"
        }
      ],
      "resources": {
        "memoryMB": 500,
        "diskMB": 1800
      }
    },
    "celery": {
      "image": "ghcr.io/dispatcharr/dispatcharr:0.32.0@sha256:b7d695c5cc98b9abd64c74a94539c1ebffc23d965021613c820c67e25dea41a3",
      "role": "worker",
      "label": "Celery worker",
      "entrypoint": [
        "/app/docker/entrypoint.celery.sh"
      ],
      "environment": {
        "DISPATCHARR_ENV": "modular",
        "DISPATCHARR_PORT": "9191",
        "POSTGRES_HOST": "db",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "dispatcharr",
        "POSTGRES_USER": "dispatch",
        "POSTGRES_PASSWORD": "{{input:dbPassword}}",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "DISPATCHARR_LOG_LEVEL": "info",
        "DJANGO_SETTINGS_MODULE": "dispatcharr.settings",
        "PYTHONUNBUFFERED": "1"
      },
      "volumes": [
        {
          "name": "data",
          "target": "/data",
          "kind": "volume"
        }
      ],
      "dependsOn": [
        {
          "service": "db",
          "condition": "service_healthy"
        },
        {
          "service": "redis",
          "condition": "service_healthy"
        },
        {
          "service": "web",
          "condition": "service_started"
        }
      ],
      "resources": {
        "memoryMB": 400,
        "diskMB": 0
      }
    },
    "db": {
      "image": "postgres:17@sha256:b8faeff7712663c2773a190181e1246e37e364b887611c04658c28b44e2408fe",
      "role": "database",
      "label": "PostgreSQL",
      "stateful": true,
      "environment": {
        "POSTGRES_DB": "dispatcharr",
        "POSTGRES_USER": "dispatch",
        "POSTGRES_PASSWORD": "{{input:dbPassword}}"
      },
      "volumes": [
        {
          "name": "postgres",
          "target": "/var/lib/postgresql/data",
          "kind": "volume",
          "description": "PostgreSQL 17 database."
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U dispatch -d dispatcharr"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 5
      },
      "resources": {
        "memoryMB": 200,
        "diskMB": 300
      }
    },
    "redis": {
      "image": "valkey/valkey:9.1.2-alpine@sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11",
      "role": "cache",
      "label": "Valkey",
      "command": [
        "valkey-server",
        "--timeout",
        "300"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "valkey-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 5
      },
      "resources": {
        "memoryMB": 30,
        "diskMB": 40
      }
    }
  },
  "inputs": [
    {
      "id": "dbPassword",
      "type": "generated",
      "bytes": 24,
      "label": "Database password"
    }
  ],
  "privileges": [],
  "dependencies": [
    "PostgreSQL 17",
    "Valkey (Redis-compatible)"
  ],
  "security": [
    "The database and cache stay on the app's private network.",
    "Uses Valkey instead of the unpinned redis:latest of the upstream file (protocol-compatible, BSD licence)."
  ],
  "authentication": {
    "forwardAuth": "caution",
    "native": [
      "local"
    ],
    "notes": [
      "M3U, EPG and HDHomeRun endpoints are fetched by media servers without a browser session; ForwardAuth blocks them. Protect the web interface only, or keep it local."
    ]
  },
  "limitations": [
    "SSDP/HDHomeRun discovery from LAN devices does not reach containers on Docker Desktop: add tuners and clients by URL."
  ],
  "update": {
    "strategy": "pinned-digest",
    "notes": "PostgreSQL major upgrades need a dump and restore."
  },
  "web": {
    "service": "web",
    "path": "/",
    "localPort": 9192
  },
  "exposure": {
    "default": "access"
  },
  "resources": {
    "memoryMB": 1130,
    "diskMB": 2140
  },
  "testStatus": {
    "static": "passed",
    "live": "passed",
    "date": "2026-11-17",
    "notes": "Installed in isolation: health, web interface, network isolation, 4-file modular stack, stop/start, Traefik file route, backup and restore, removal with data."
  }
}
