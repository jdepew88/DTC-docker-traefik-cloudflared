# Rename to .yml only if you need to proxy an application running directly on Windows.
# Inspect the app's listening interface, port and firewall; host.docker.internal resolves to the host.
http:
  routers:
    windows-app:
      rule: Host(`windows-app.example.com`)
      entryPoints: [web]
      service: windows-app
  services:
    windows-app:
      loadBalancer:
        servers:
          - url: http://host.docker.internal:3000
