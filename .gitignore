# Secrets and local configuration
.env
secrets/
*token*
# Site-specific state rendered on the deployed host
config/services.json
config/cloudflare.json
config/setup.json
config/dashboard.json
# Every other deployment's own settings (identity, credentials, applications, managers, provisioning, personal
# customizations); only the shipped examples are tracked.
config/*.json
!config/*.example.json
config/provision/
# Private notes about one deployment
notes/
traefik/dynamic/admin-dashboard.yml
logs/
traefik/dynamic/svc-*.yml
traefik/dynamic/zz-test-*.yml
traefik/dynamic/*.local.yml
traefik/dynamic/app-*.yml
traefik/dynamic/.reload
*.tmp-*
# Wizard state (no secrets, but deployment-specific)
tunnel.json
# Installer state
backups/
.install-manifest.json
*.dist
*.bak*
# Original package archive
zipped project start/
*.zip
*.log
.DS_Store
__pycache__/
# Local-only notes that may hold credentials
API key*
# Launcher built locally by Setup-Launcher.cmd (lib\Launcher.psm1 New-LauncherExe)
launcher/DTC.exe
launcher/DTC.ico
