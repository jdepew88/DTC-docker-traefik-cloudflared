#requires -version 5.1
# Adopt an application that was installed independently of this manager: read-only discovery, then a staged migration
# (preview -> validate -> prepare -> activate -> test -> approve Cloudflare -> cut over -> verify -> retire old proxy).
#
# An application is described by a routing specification (catalog\adoption\<id>.json, or generated for a single container),
# never by code here. Adoption adds route files next to the registry's (traefik\dynamic\adopt-<id>-external.yml and
# -internal.yml) and does not touch services.json, the application's containers beyond an approved `docker network connect`,
# its compose file, its volumes or its models.
#
# Local proxy reachability, DNS, TLS and sign-in are separate checks with separate states: ok, failed or unverified. A check
# that was not actually made is `unverified`, never `ok`.
#
# Pure functions take facts and return decisions. Functions that read or change this PC say so.
Set-StrictMode -Version 2.0

$script:SpecVersion = 1
$script:IdPattern = '^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$'
$script:HostnamePattern = '^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
$script:PathPattern = '^/[A-Za-z0-9._~/-]{0,120}$'
$script:DurationPattern = '^\d{1,5}(ms|s|m|h)$'
$script:EndpointPattern = '^http://[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}:\d{1,5}$'
$script:Modes = @('none', 'internal', 'external', 'both')
$script:GeneratedHeader = '# Generated by the adoption workflow'
$script:AuthMiddlewareHint = '(?i)auth|authentik|authelia|forward'
$script:OutpostPrefix = '/outpost.goauthentik.io/'
$script:Utf8NoBom = New-Object System.Text.UTF8Encoding($false)

function Get-AdProp($Object, [string]$Name, $Default = $null) {
  if ($null -eq $Object) { return $Default }
  if ($Object -is [System.Collections.IDictionary]) { if ($Object.Contains($Name) -and $null -ne $Object[$Name]) { return $Object[$Name] }; return $Default }
  $p = $Object.PSObject.Properties[$Name]
  if ($p -and $null -ne $p.Value) { return $p.Value }
  return $Default
}

function Get-AdoptionRoot($Settings, [string]$Id) {
  if ($Id -notmatch $script:IdPattern) { throw "Invalid application id '$Id'." }
  return (Join-Path $Settings.InstallPath "config\adoptions\$Id")
}

# --- Routing specification --------------------------------------------------------------------------------------------------

# Pure. Returns a list of problems; an empty list means the specification can be used.
function Test-AdoptionSpec($Spec) {
  $issues = New-Object System.Collections.ArrayList
  $err = { param($m) $null = $issues.Add([string]$m) }
  if ([int](Get-AdProp $Spec 'schemaVersion' 0) -ne $script:SpecVersion) { & $err "schemaVersion must be $($script:SpecVersion)." }
  if ([string](Get-AdProp $Spec 'id' '') -notmatch $script:IdPattern) { & $err 'id must be 1-40 lowercase letters, digits or dashes.' }
  $backends = @(Get-AdProp $Spec 'backends' @())
  $routes = @(Get-AdProp $Spec 'routes' @())
  if (-not $backends.Count) { & $err 'At least one backend is required.' }
  if (-not $routes.Count) { & $err 'At least one route is required.' }
  $ids = @($backends | ForEach-Object { [string](Get-AdProp $_ 'id' '') })
  if (@($ids | Select-Object -Unique).Count -ne $ids.Count) { & $err 'Backend ids must be unique.' }
  foreach ($b in $backends) {
    $id = [string](Get-AdProp $b 'id' '')
    if ($id -notmatch $script:IdPattern) { & $err "Backend id '$id' is invalid." }
    $kind = [string](Get-AdProp $b 'kind' '')
    if ($kind -notin 'container', 'host') { & $err "Backend '$id': kind must be container or host." }
    if ($kind -eq 'container' -and -not @(Get-AdProp $b 'containerNames' @()).Count -and -not (Get-AdProp $b 'composeService' '') -and -not (Get-AdProp $b 'imagePattern' '')) { & $err "Backend '$id': say how to find its container (containerNames, composeService or imagePattern)." }
    $port = [int](Get-AdProp $b 'port' 0)
    if ($port -lt 1 -or $port -gt 65535) { & $err "Backend '$id': port must be 1-65535." }
    if ([string](Get-AdProp $b 'protocol' 'http') -notin 'http', 'https') { & $err "Backend '$id': protocol must be http or https." }
    $hp = [string](Get-AdProp $b 'healthPath' '/')
    if ($hp -notmatch $script:PathPattern) { & $err "Backend '$id': healthPath is invalid." }
    $t = Get-AdProp $b 'timeouts' $null
    foreach ($k in 'dial', 'responseHeader', 'idleConn') {
      $v = [string](Get-AdProp $t $k '')
      if ($v -and $v -notmatch $script:DurationPattern) { & $err "Backend '$id': timeouts.$k '$v' is not a duration like 30s." }
    }
  }
  $routeIds = @($routes | ForEach-Object { [string](Get-AdProp $_ 'id' '') })
  if (@($routeIds | Select-Object -Unique).Count -ne $routeIds.Count) { & $err 'Route ids must be unique.' }
  $paths = @($routes | ForEach-Object { [string](Get-AdProp $_ 'pathPrefix' '') })
  if (@($paths | Select-Object -Unique).Count -ne $paths.Count) { & $err 'Two routes use the same path.' }
  $priorities = @($routes | ForEach-Object { [int](Get-AdProp $_ 'priority' 0) })
  if (@($priorities | Select-Object -Unique).Count -ne $priorities.Count) { & $err 'Route priorities must be unique, so that path order is not left to rule length.' }
  foreach ($r in $routes) {
    $id = [string](Get-AdProp $r 'id' '')
    if ($id -notmatch $script:IdPattern) { & $err "Route id '$id' is invalid." }
    if ($ids -notcontains [string](Get-AdProp $r 'backend' '')) { & $err "Route '$id' names an unknown backend." }
    $path = [string](Get-AdProp $r 'pathPrefix' '')
    if ($path -and ($path -notmatch $script:PathPattern -or $path -eq '/')) { & $err "Route '$id': pathPrefix '$path' is invalid (omit it for the catch-all route)." }
    if ([bool](Get-AdProp $r 'stripPrefix' $false) -and -not $path) { & $err "Route '$id': stripPrefix needs a pathPrefix." }
    $prio = [int](Get-AdProp $r 'priority' 0)
    if ($prio -lt 1 -or $prio -gt 9000) { & $err "Route '$id': priority must be 1-9000." }
    $limit = [long](Get-AdProp $r 'maxRequestBodyBytes' 0)
    if ($limit -lt 0) { & $err "Route '$id': maxRequestBodyBytes cannot be negative." }
    # Traefik's buffering middleware reads the whole request and response before passing them on.
    if ($limit -gt 0 -and [bool](Get-AdProp $r 'websocket' $false)) { & $err "Route '$id': an upload limit uses request buffering, which does not work with WebSocket. Use separate routes." }
    foreach ($m in @(Get-AdProp $r 'middlewares' @())) {
      if ([string]$m -match $script:AuthMiddlewareHint) { & $err "Route '$id': sign-in middleware '$m' cannot be in the specification: sign-in is added to the external route only." }
      if ([string]$m -notmatch '^[A-Za-z0-9_-]+(@[a-z]+)?$') { & $err "Route '$id': middleware '$m' is invalid." }
    }
  }
  # Without a higher priority a catch-all route would take path traffic if its rule happened to be longer.
  $catchAll = @($routes | Where-Object { -not (Get-AdProp $_ 'pathPrefix' '') })
  if ($catchAll.Count -gt 1) { & $err 'Only one route may omit pathPrefix.' }
  if ($catchAll.Count -eq 1) {
    foreach ($r in @($routes | Where-Object { Get-AdProp $_ 'pathPrefix' '' })) {
      if ([int](Get-AdProp $r 'priority' 0) -le [int](Get-AdProp $catchAll[0] 'priority' 0)) { & $err "Route '$(Get-AdProp $r 'id' '')' must have a higher priority than the catch-all route." }
    }
  }
  return @($issues.ToArray())
}

# Reads this PC: the specifications in catalog\adoption. An invalid one is reported, not silently used.
function Get-AdoptionSpecs([string]$CatalogDir) {
  $dir = Join-Path $CatalogDir 'adoption'
  if (-not (Test-Path -LiteralPath $dir)) { return @() }
  return @(Get-ChildItem -LiteralPath $dir -Filter '*.json' -File | ForEach-Object {
      $spec = [IO.File]::ReadAllText($_.FullName) | ConvertFrom-Json
      $problems = @(Test-AdoptionSpec $spec)
      if ($problems.Count) { throw "$($_.Name): $($problems -join ' ')" }
      $spec
    })
}

# Pure. A specification for one discovered container: single-service adoption without a catalog entry.
function New-SingleServiceSpec($Container, [int]$Port) {
  if ($Container.infrastructure -or $Container.privateService) { throw "$($Container.name) is infrastructure or a private service (database, cache) and is never published." }
  if ($Port -in 2375, 2376) { throw 'The Docker Engine API is never published.' }
  $slug = (([string]$Container.name).ToLowerInvariant() -replace '[^a-z0-9-]+', '-').Trim('-')
  if ($slug.Length -gt 40) { $slug = $slug.Substring(0, 40).Trim('-') }
  return [pscustomobject][ordered]@{
    schemaVersion = $script:SpecVersion; id = $slug; displayName = [string]$Container.name; defaultSubdomain = ($slug -split '-')[0]
    backends = @([pscustomobject][ordered]@{ id = 'app'; kind = 'container'; containerNames = @([string]$Container.name); port = $Port; protocol = 'http'; healthPath = '/'; required = $true })
    routes = @([pscustomobject][ordered]@{ id = 'app'; backend = 'app'; priority = 100; websocket = $true })
  }
}

# --- Discovery (pure over facts) --------------------------------------------------------------------------------------------

# Who manages a container, from its Compose labels. `recreated` warns that a redeploy drops `docker network connect`.
function Get-ContainerOwner($Container) {
  $c = $Container.compose
  $wd = [string](Get-AdProp $c 'workingDir' '')
  $project = [string](Get-AdProp $c 'project' '')
  if (-not $project) { return [ordered]@{ manager = 'manual'; project = ''; workingDir = ''; note = 'Started with docker run. A new docker run needs --network to keep its networks.' } }
  $manager = 'compose'
  if ($wd -match '(^|[\\/])data[\\/]compose[\\/]\d+') { $manager = 'portainer' }
  elseif ($wd -match '(^|[\\/])arcane[\\/]|[\\/]app[\\/]data[\\/]projects[\\/]') { if ([string]$Container.name -ne 'arcane') { $manager = 'arcane' } }
  $label = @{ compose = 'Docker Compose'; portainer = 'a Portainer stack'; arcane = 'an Arcane project' }[$manager]
  return [ordered]@{ manager = $manager; project = $project; workingDir = $wd; note = "Managed by $label. Recreating it from its definition drops networks that are not declared there." }
}

# Pure: the containers that match one backend of a specification.
function Find-BackendMatches($Backend, $Containers) {
  $names = @(Get-AdProp $Backend 'containerNames' @() | ForEach-Object { ([string]$_).ToLowerInvariant() })
  $service = [string](Get-AdProp $Backend 'composeService' '')
  $image = [string](Get-AdProp $Backend 'imagePattern' '')
  return @($Containers | Where-Object {
      ($names.Count -and $names -contains ([string]$_.name).ToLowerInvariant()) -or
      ($service -and [string]$_.compose.service -eq $service) -or
      ($image -and [string]$_.image -match $image)
    })
}

# Pure: what is on this engine, read-only: adoptable applications, routes, conflicts, unreachable backends, redundant proxies.
function ConvertTo-AdoptionInventory {
  param($Containers = @(), $Routers = @(), $Specs = @(), $Networks = @(), [string]$ProxyNetwork = '', [string[]]$OwnStacks = @())
  $apps = New-Object System.Collections.ArrayList
  $claimed = @{}
  foreach ($s in @($Specs)) {
    $found = @(foreach ($b in @($s.backends | Where-Object { $_.kind -eq 'container' })) { foreach ($m in @(Find-BackendMatches $b $Containers)) { $claimed[[string]$m.name] = $true; [ordered]@{ backend = [string]$b.id; container = [string]$m.name; state = [string]$m.state; owner = (Get-ContainerOwner $m); onProxyNetwork = [bool]@($m.networks | Where-Object { $_.name -eq $ProxyNetwork }).Count } } })
    if (-not $found.Count) { continue }
    $null = $apps.Add([ordered]@{ kind = 'specification'; id = [string]$s.id; displayName = [string]$s.displayName; description = [string](Get-AdProp $s 'description' ''); multiBackend = (@($s.backends).Count -gt 1); backendCount = @($s.backends).Count; routeCount = @($s.routes).Count; containers = @($found) })
  }
  # Anything else that looks like an application is listed, and stays unpublished until someone adopts it.
  foreach ($c in @($Containers)) {
    if ($claimed.ContainsKey([string]$c.name) -or $c.infrastructure -or $c.privateService -or $c.managedBy) { continue }
    if (-not @($c.exposed).Count) { continue }
    $null = $apps.Add([ordered]@{ kind = 'container'; id = [string]$c.name; displayName = [string]$c.name; state = [string]$c.state; owner = (Get-ContainerOwner $c); onProxyNetwork = [bool]@($c.networks | Where-Object { $_.name -eq $ProxyNetwork }).Count
        ports = @($c.exposed | ForEach-Object { [int]$_.port }); labelRouters = @($c.traefik.routers | ForEach-Object { [string]$_.name }) })
  }
  # The same hostname and path claimed twice in this Traefik.
  $seen = @{}
  $conflicts = New-Object System.Collections.ArrayList
  foreach ($r in @($Routers)) {
    $key = [string](Get-AdProp $r 'rule' '')
    if (-not $key) { continue }
    if ($seen.ContainsKey($key)) { $null = $conflicts.Add([ordered]@{ kind = 'router'; detail = "Routers $($seen[$key]) and $(Get-AdProp $r 'name' '') use the same rule: $key" }) } else { $seen[$key] = [string](Get-AdProp $r 'name' '') }
  }
  # A backend on no network the proxy shares and without a published port cannot be reached without a change.
  $unreachable = @(@($Containers) | Where-Object { -not $_.infrastructure -and -not $_.privateService -and $_.state -eq 'running' -and @($_.exposed).Count -and -not @($_.published).Count -and -not @($_.networks | Where-Object { $_.name -eq $ProxyNetwork }).Count } | ForEach-Object { [string]$_.name })
  # Proxies and tunnel connectors that are not part of this deployment, and networks of stacks with nothing left on them.
  $redundant = New-Object System.Collections.ArrayList
  foreach ($c in @($Containers | Where-Object { $_.infrastructure })) {
    $project = [string]$c.compose.project
    if ($OwnStacks -contains $project) { continue }
    $null = $redundant.Add([ordered]@{ type = 'container'; name = [string]$c.name; state = [string]$c.state; project = $project; detail = 'A reverse proxy or tunnel connector outside this deployment.' })
  }
  foreach ($n in @($Networks)) {
    $project = [string](Get-AdProp $n 'project' '')
    if (-not $project -or $OwnStacks -contains $project -or @(Get-AdProp $n 'containers' @()).Count) { continue }
    if ("$project $($n.name)" -notmatch '(?i)traefik|cloudflared|tunnel') { continue }
    $null = $redundant.Add([ordered]@{ type = 'network'; name = [string]$n.name; state = 'unused'; project = $project; detail = 'A network of a proxy stack with no container attached.' })
  }
  return [ordered]@{ apps = @($apps.ToArray()); conflicts = @($conflicts.ToArray()); unreachable = $unreachable; redundant = @($redundant.ToArray()); routers = @(@($Routers) | ForEach-Object { [ordered]@{ name = [string](Get-AdProp $_ 'name' ''); rule = [string](Get-AdProp $_ 'rule' ''); status = [string](Get-AdProp $_ 'status' '') } }) }
}

# Reads this PC, changes nothing: containers, networks, routers of both proxies, the service registry, existing route files.
function Get-AdoptionFacts($Settings) {
  $containers = @(Get-DockerContainerInventory -ProxyNetwork $Settings.ProxyNetwork)
  $networks = @()
  $ls = Invoke-Docker network ls -q
  if ($ls.ExitCode -eq 0 -and @($ls.Output).Count) {
    $ins = Invoke-Docker @(@('network', 'inspect') + @($ls.Output | Where-Object { $_ }))
    if ($ins.ExitCode -eq 0) {
      $networks = @(((@($ins.Output) -join "`n") | ConvertFrom-Json) | ForEach-Object { $_ } | ForEach-Object {
          $labels = Get-AdProp $_ 'Labels' $null
          $attached = @(); $cs = Get-AdProp $_ 'Containers' $null
          if ($cs) { $attached = @($cs.PSObject.Properties | ForEach-Object { [string]$_.Value.Name }) }
          [ordered]@{ name = [string]$_.Name; project = [string](Get-AdProp $labels 'com.docker.compose.project' ''); containers = $attached }
        })
    }
  }
  $targets = Get-AdoptionProxyTargets -Settings $Settings -Containers $containers
  $routers = @{ external = @(); internal = @() }
  foreach ($role in 'external', 'internal') {
    $t = $targets[$role]
    if ($t.settings -and $t.running) { $routers[$role] = @(Get-TraefikApi -Settings $t.settings -Path '/api/http/routers' | Where-Object { $_ }) }
  }
  $registry = @()
  try { $registry = @((Read-ServiceRegistry -Settings $Settings).services) } catch { }
  return [ordered]@{ containers = $containers; networks = $networks; targets = $targets; routers = $routers; services = $registry }
}

# Reads this PC. The external proxy is this deployment. The internal proxy is, in order: the folder in config\adoption.json,
# a running stack named traefik-int*, or the LAN entry point of Networking v2 on this same Traefik. Otherwise it is absent:
# internal routes can be previewed, not activated.
function Get-AdoptionProxyTargets {
  param([Parameter(Mandatory = $true)]$Settings, $Containers = @())
  $running = { param($name) [bool]@(@($Containers) | Where-Object { $_.name -eq $name -and $_.state -eq 'running' }).Count }
  $external = [ordered]@{ role = 'external'; mode = 'stack'; name = $Settings.StackName; settings = $Settings; entryPoint = 'web'; network = $Settings.ProxyNetwork; running = (& $running $Settings.TraefikContainer); detail = "This deployment ($($Settings.StackName))." }
  $internal = [ordered]@{ role = 'internal'; mode = 'absent'; name = ''; settings = $null; entryPoint = ''; network = ''; running = $false; detail = 'No internal proxy found (no traefik-int stack and no LAN entry point). Internal routes can be previewed but not activated.' }
  $folder = ''
  $cfgPath = Join-Path $Settings.InstallPath 'config\adoption.json'
  if (Test-Path -LiteralPath $cfgPath) { $folder = [string](Get-AdProp ([IO.File]::ReadAllText($cfgPath) | ConvertFrom-Json) 'internalInstallPath' '') }
  if (-not $folder) {
    $found = @(@($Containers) | Where-Object { $_.infrastructure -and [string]$_.name -match '(^|[-_])traefik-int\d*(-traefik)?$' -and $_.compose.workingDir } | Select-Object -First 1)
    if ($found.Count) { $folder = [string]$found[0].compose.workingDir }
  }
  if ($folder -and (Test-Path -LiteralPath (Join-Path $folder '.env'))) {
    $s = Get-StackSettings -InstallPath $folder
    if ($s.StackName -ne $Settings.StackName) {
      $internal = [ordered]@{ role = 'internal'; mode = 'stack'; name = $s.StackName; settings = $s; entryPoint = 'web'; network = $s.ProxyNetwork; running = (& $running $s.TraefikContainer); detail = "Separate internal proxy stack $($s.StackName)." }
    }
  } elseif (Test-Path -LiteralPath (Join-Path $Settings.InstallPath 'infrastructure\traefik\compose.lan.yaml')) {
    $internal = [ordered]@{ role = 'internal'; mode = 'lan-entrypoint'; name = "$($Settings.StackName) (LAN entry point)"; settings = $Settings; entryPoint = 'lan-secure'; network = $Settings.ProxyNetwork; running = $external.running; detail = 'The LAN entry point of this Traefik (Networking v2).' }
  }
  return @{ external = $external; internal = $internal }
}

# --- Generated Traefik configuration ----------------------------------------------------------------------------------------

function Get-RouterPrefix([string]$Id, [string]$Role) { return "adopt-$Id-$(if ($Role -eq 'external') { 'ext' } else { 'int' })" }
function Get-AdoptionFileName([string]$Id, [string]$Role) { return "adopt-$Id-$Role.yml" }

# The ForwardAuth block is taken from the registry's generator, so authentik's address and headers stay defined in one place.
function Get-ForwardAuthLines([string]$Endpoint) {
  $dummy = ConvertTo-ServiceDefinition ([pscustomobject]@{ name = 'x'; hostnames = @('x.example.test'); target = [pscustomobject]@{ type = 'docker'; host = 'x'; port = 80; protocol = 'http' }; auth = [pscustomobject]@{ provider = 'authentik'; endpoint = $Endpoint } })
  $lines = @((ConvertTo-TraefikRouteYaml $dummy) -split "`r?`n")
  $start = [array]::IndexOf($lines, '    svc-x-authentik:')
  if ($start -lt 0) { throw 'The route generator did not produce a sign-in middleware.' }
  $out = New-Object System.Collections.ArrayList
  for ($i = $start + 1; $i -lt $lines.Count; $i++) {
    if ($lines[$i] -notmatch '^      ') { break }
    $null = $out.Add($lines[$i])
  }
  return @($out.ToArray())
}

# Pure apart from the generator above. All values were validated, so the only quoting needed is around rules.
function ConvertTo-AdoptionYaml {
  param(
    [Parameter(Mandatory = $true)]$Spec,
    [Parameter(Mandatory = $true)][ValidateSet('external', 'internal')][string]$Role,
    [Parameter(Mandatory = $true)][string]$Hostname,
    [Parameter(Mandatory = $true)][hashtable]$BackendUrls,
    [string]$EntryPoint = 'web',
    [string]$AuthEndpoint = ''
  )
  $pre = Get-RouterPrefix $Spec.id $Role
  $auth = [bool]($Role -eq 'external' -and $AuthEndpoint)
  $headers = $(if ($Role -eq 'external') { 'default-headers@file' } else { "$pre-headers" })
  $routes = @($Spec.routes | Sort-Object { -[int]$_.priority } | Where-Object { $BackendUrls.ContainsKey([string]$_.backend) })
  $l = New-Object System.Collections.Generic.List[string]
  $l.Add("$($script:GeneratedHeader) for '$($Spec.id)' ($Role). Do not edit by hand: use the Adopt page, or roll back there.")
  $l.Add($(if ($Role -eq 'external') { "# External route: sign-in $(if ($auth) { "through authentik at $AuthEndpoint" } else { 'NOT required (explicitly accepted)' }). Reached through Cloudflare Tunnel." } else { '# Internal route: no authentik and no Cloudflare; only LAN DNS points here.' }))
  $l.Add('http:')
  $l.Add('  routers:')
  foreach ($r in $routes) {
    $path = [string](Get-AdProp $r 'pathPrefix' '')
    $rule = 'Host(`' + $Hostname + '`)' + $(if ($path) { ' && PathPrefix(`' + $path + '`)' } else { '' })
    $chain = @()
    if ($auth) { $chain += "$pre-authentik" }
    if ([bool](Get-AdProp $r 'stripPrefix' $false)) { $chain += "$pre-$($r.id)-strip" }
    if ([long](Get-AdProp $r 'maxRequestBodyBytes' 0) -gt 0) { $chain += "$pre-$($r.id)-limit" }
    $chain += @(Get-AdProp $r 'middlewares' @() | ForEach-Object { [string]$_ })
    $chain += $headers
    $l.Add("    ${pre}-$($r.id):")
    $l.Add("      rule: '$rule'")
    $l.Add("      entryPoints: [$EntryPoint]")
    # Explicit priorities: the order comes from the specification, not from how long a rule happens to be.
    $l.Add("      priority: $(1000 + [int]$r.priority)")
    $l.Add('      middlewares: [' + ($chain -join ', ') + ']')
    $l.Add("      service: $pre-$($r.backend)")
  }
  if ($auth) {
    $l.Add("    ${pre}-outpost:")
    $l.Add("      rule: 'Host(``$Hostname``) && PathPrefix(``$($script:OutpostPrefix)``)'")
    $l.Add("      entryPoints: [$EntryPoint]")
    $l.Add('      priority: 20000')
    $l.Add("      middlewares: [$headers]")
    $l.Add("      service: $pre-outpost")
  }
  $middlewaresAt = $l.Count
  $l.Add('  middlewares:')
  if ($Role -eq 'internal') {
    # Without HSTS: an internal hostname can run on a self-signed certificate while it is being tested.
    $l.Add("    ${pre}-headers:")
    $l.Add('      headers:')
    $l.Add('        contentTypeNosniff: true')
    $l.Add('        referrerPolicy: strict-origin-when-cross-origin')
  }
  if ($auth) {
    $l.Add("    ${pre}-authentik:")
    foreach ($line in @(Get-ForwardAuthLines $AuthEndpoint)) { $l.Add($line) }
  }
  foreach ($r in $routes) {
    if ([bool](Get-AdProp $r 'stripPrefix' $false)) {
      $l.Add("    ${pre}-$($r.id)-strip:")
      $l.Add('      stripPrefix:')
      $l.Add("        prefixes: [$($r.pathPrefix)]")
    }
    $limit = [long](Get-AdProp $r 'maxRequestBodyBytes' 0)
    if ($limit -gt 0) {
      $l.Add("    ${pre}-$($r.id)-limit:")
      $l.Add('      buffering:')
      $l.Add("        maxRequestBodyBytes: $limit")
    }
  }
  if ($l.Count -eq $middlewaresAt + 1) { $l.RemoveAt($middlewaresAt) }
  $l.Add('  services:')
  $transports = New-Object System.Collections.ArrayList
  foreach ($id in @($routes | ForEach-Object { [string]$_.backend } | Select-Object -Unique)) {
    $b = @($Spec.backends | Where-Object { $_.id -eq $id })[0]
    $t = Get-AdProp $b 'timeouts' $null
    $skip = [bool](Get-AdProp $b 'tlsSkipVerify' $false)
    $l.Add("    ${pre}-${id}:")
    $l.Add('      loadBalancer:')
    $l.Add('        passHostHeader: true')
    if ($t -or $skip) { $l.Add("        serversTransport: $pre-$id-transport"); $null = $transports.Add($b) }
    $l.Add('        servers:')
    $l.Add("          - url: $($BackendUrls[$id])")
  }
  if ($auth) {
    $l.Add("    ${pre}-outpost:")
    $l.Add('      loadBalancer:')
    $l.Add('        passHostHeader: true')
    $l.Add('        servers:')
    $l.Add("          - url: $AuthEndpoint")
  }
  if ($transports.Count) {
    $l.Add('  serversTransports:')
    foreach ($b in $transports) {
      $t = Get-AdProp $b 'timeouts' $null
      $l.Add("    ${pre}-$($b.id)-transport:")
      if ([bool](Get-AdProp $b 'tlsSkipVerify' $false)) { $l.Add('      insecureSkipVerify: true') }
      if ($t) {
        $l.Add('      forwardingTimeouts:')
        foreach ($pair in @(@('dial', 'dialTimeout'), @('responseHeader', 'responseHeaderTimeout'), @('idleConn', 'idleConnTimeout'))) {
          $v = [string](Get-AdProp $t $pair[0] '')
          if ($v) { $l.Add("        $($pair[1]): $v") }
        }
      }
    }
  }
  return (($l -join "`n") + "`n")
}

# --- Plan (pure over facts) -------------------------------------------------------------------------------------------------

function ConvertTo-AdoptionRequest($InputObject) {
  $mode = ([string](Get-AdProp $InputObject 'mode' 'none')).Trim().ToLowerInvariant()
  return [ordered]@{
    mode = $mode
    externalHost = ([string](Get-AdProp $InputObject 'externalHost' '')).Trim().ToLowerInvariant()
    internalHost = ([string](Get-AdProp $InputObject 'internalHost' '')).Trim().ToLowerInvariant()
    authEndpoint = ([string](Get-AdProp $InputObject 'authEndpoint' '')).Trim().TrimEnd('/')
    noAuth = [bool](Get-AdProp $InputObject 'noAuth' $false)
  }
}

function Get-RoleHostname($Request, [string]$Role) { return $(if ($Role -eq 'external') { $Request.externalHost } else { $Request.internalHost }) }
function Get-RequestRoles($Request) { return @(@('external', 'internal') | Where-Object { $Request.mode -eq 'both' -or $Request.mode -eq $_ }) }

function Get-AdoptionPlan {
  param([Parameter(Mandatory = $true)]$Spec, [Parameter(Mandatory = $true)]$Request, [Parameter(Mandatory = $true)]$Facts, [hashtable]$ExistingFiles = @{})
  $blockers = New-Object System.Collections.ArrayList
  $warnings = New-Object System.Collections.ArrayList
  $req = ConvertTo-AdoptionRequest $Request
  if ($script:Modes -notcontains $req.mode) { $null = $blockers.Add("Routing must be one of: $($script:Modes -join ', ').") }
  foreach ($p in @(Test-AdoptionSpec $Spec)) { $null = $blockers.Add("Specification: $p") }
  $roles = @(Get-RequestRoles $req)
  foreach ($role in $roles) {
    $h = Get-RoleHostname $req $role
    if (-not $h) { $null = $blockers.Add("An $role hostname is required.") }
    elseif ($h -notmatch $script:HostnamePattern) { $null = $blockers.Add("'$h' is not a valid hostname.") }
  }
  if ($req.mode -eq 'both' -and $req.externalHost -and $req.externalHost -eq $req.internalHost) { $null = $blockers.Add('The internal and external hostnames must differ: an internal name must never be published.') }
  if ($roles -contains 'external' -and -not $req.noAuth) {
    if (-not $req.authEndpoint) { $null = $blockers.Add('The external route needs authentik: choose its address, or explicitly accept publishing without sign-in.') }
    elseif ($req.authEndpoint -notmatch $script:EndpointPattern) { $null = $blockers.Add("'$($req.authEndpoint)' is not an internal http://<container>:<port> address.") }
  }
  if ($roles -contains 'external' -and $req.noAuth) { $null = $warnings.Add('The external route has no sign-in: anyone on the Internet who has the address can use this application.') }

  # Backends: which container, its state, and how each proxy reaches it.
  $backendViews = New-Object System.Collections.ArrayList
  $backendById = @{}
  foreach ($b in @($Spec.backends)) {
    $view = [ordered]@{ id = [string]$b.id; kind = [string]$b.kind; description = [string](Get-AdProp $b 'description' ''); required = [bool](Get-AdProp $b 'required' $true); port = [int]$b.port; protocol = [string](Get-AdProp $b 'protocol' 'http'); healthPath = [string](Get-AdProp $b 'healthPath' '/'); container = ''; state = ''; owner = $null; networks = @(); blockers = @() }
    if ($b.kind -eq 'host') { $view.state = 'host'; $view.container = '' }
    else {
      $m = @(Find-BackendMatches $b $Facts.containers)
      if ($m.Count -eq 0) { $view.state = 'missing'; if ($view.required) { $null = $blockers.Add("Backend '$($b.id)': no matching container on this Docker engine.") } else { $null = $warnings.Add("Optional backend '$($b.id)' has no container; its routes are left out.") } }
      elseif ($m.Count -gt 1) { $view.state = 'ambiguous'; $null = $blockers.Add("Backend '$($b.id)' matches several containers ($(@($m | ForEach-Object { $_.name }) -join ', ')); it must be exactly one.") }
      else {
        $c = $m[0]
        $view.container = [string]$c.name; $view.state = [string]$c.state; $view.owner = (Get-ContainerOwner $c); $view.networks = @($c.networks | ForEach-Object { [string]$_.name })
        if ($c.privateService) { $null = $blockers.Add("Backend '$($b.id)': $($c.name) is a database or cache and is never published.") }
        if ($c.state -ne 'running') { $null = $warnings.Add("Backend '$($b.id)': $($c.name) is $($c.state). Adoption does not start it; its route will not answer until you do.") }
      }
    }
    $null = $backendViews.Add($view); $backendById[[string]$b.id] = $view
  }

  # Per proxy: backend addresses, network changes, hostname conflicts, the generated file.
  $networkChanges = New-Object System.Collections.ArrayList
  $targetViews = New-Object System.Collections.ArrayList
  $allNetworks = @(@(Get-AdProp $Facts 'networks' @()) | ForEach-Object { [string]$_.name })
  foreach ($role in $roles) {
    $t = $Facts.targets[$role]
    $h = Get-RoleHostname $req $role
    if ($t.mode -eq 'absent') { $null = $blockers.Add("Internal routing: $($t.detail)") }
    elseif (-not $t.running) { $null = $warnings.Add("The $role proxy ($($t.name)) is not running.") }
    if ($t.mode -ne 'absent' -and $allNetworks.Count -and $allNetworks -notcontains $t.network) { $null = $blockers.Add("The $role proxy's network '$($t.network)' does not exist.") }
    $urls = @{}
    foreach ($b in @($Spec.backends)) {
      $v = $backendById[[string]$b.id]
      if ($b.kind -eq 'host') { $urls[[string]$b.id] = "$($v.protocol)://host.docker.internal:$($b.port)"; continue }
      if (-not $v.container) { continue }
      $urls[[string]$b.id] = "$($v.protocol)://$($v.container):$($b.port)"
      if ($t.network -and @($v.networks) -notcontains $t.network) {
        $own = @($networkChanges | Where-Object { $_.container -eq $v.container -and $_.network -eq $t.network })
        if (-not $own.Count) { $null = $networkChanges.Add([ordered]@{ container = $v.container; network = $t.network; role = $role; backend = [string]$b.id; command = "docker network connect $($t.network) $($v.container)"; note = $(if ($v.owner) { $v.owner.note } else { '' }); composeSnippet = @('    networks:', "      - $($t.network)", 'networks:', "  $($t.network):", '    external: true') }) }
      }
    }
    $own = "^adopt-$([regex]::Escape([string]$Spec.id))-"
    $claims = @()
    if ($h) {
      foreach ($r2 in 'external', 'internal') {
        $others = @(@(Get-AdProp $Facts.routers $r2 @()) | Where-Object { [string](Get-AdProp $_ 'name' '') -notmatch $own })
        $claims += @(Find-HostnameClaims -Hostname $h -Services @(Get-AdProp $Facts 'services' @()) -Routers $others -Containers @($Facts.containers))
      }
    }
    foreach ($c in @($claims | Sort-Object { $_.source + $_.name } -Unique)) {
      if ($c.level -eq 'error') { $null = $blockers.Add("${h}: $($c.detail)") } else { $null = $warnings.Add("${h}: $($c.detail)") }
    }
    $content = ''; $routerViews = @()
    if ($h -and $h -match $script:HostnamePattern -and $urls.Count -and -not (@(Test-AdoptionSpec $Spec).Count)) {
      $pre = Get-RouterPrefix $Spec.id $role
      $authOn = [bool]($role -eq 'external' -and -not $req.noAuth -and $req.authEndpoint -match $script:EndpointPattern)
      $content = ConvertTo-AdoptionYaml -Spec $Spec -Role $role -Hostname $h -BackendUrls $urls -EntryPoint $(if ($t.entryPoint) { $t.entryPoint } else { 'web' }) -AuthEndpoint $(if ($authOn) { $req.authEndpoint } else { '' })
      $routerViews = @(@($Spec.routes | Where-Object { $urls.ContainsKey([string]$_.backend) } | Sort-Object { -[int]$_.priority }) | ForEach-Object {
          [ordered]@{ name = "$pre-$($_.id)"; route = [string]$_.id; path = [string](Get-AdProp $_ 'pathPrefix' ''); rule = 'Host(`' + $h + '`)' + $(if (Get-AdProp $_ 'pathPrefix' '') { ' && PathPrefix(`' + $_.pathPrefix + '`)' } else { '' }); priority = 1000 + [int]$_.priority; backend = [string]$_.backend; url = $urls[[string]$_.backend]; stripPrefix = [bool](Get-AdProp $_ 'stripPrefix' $false); websocket = [bool](Get-AdProp $_ 'websocket' $false); websocketTestPath = [string](Get-AdProp $_ 'websocketTestPath' ''); maxRequestBodyBytes = [long](Get-AdProp $_ 'maxRequestBodyBytes' 0); signIn = $authOn }
        })
    }
    $name = Get-AdoptionFileName $Spec.id $role
    $existing = $(if ($ExistingFiles.ContainsKey("$role/$name")) { [string]$ExistingFiles["$role/$name"] } else { '' })
    $action = $(if (-not $existing) { 'create' } elseif ($existing -eq $content) { 'unchanged' } else { 'update' })
    if ($existing -and -not $existing.StartsWith($script:GeneratedHeader)) { $null = $blockers.Add("$name already exists and was not generated by this workflow; it is never overwritten.") }
    $null = $targetViews.Add([ordered]@{ role = $role; proxy = [string]$t.name; proxyMode = [string]$t.mode; hostname = $h; entryPoint = [string]$t.entryPoint; network = [string]$t.network; signIn = $(if ($role -eq 'external' -and -not $req.noAuth) { 'authentik' } else { 'none' }); routers = $routerViews; file = [ordered]@{ name = $name; action = $action; content = $content } })
  }
  foreach ($n in @(Get-AdProp $Spec 'notes' @())) { $null = $warnings.Add([string]$n) }
  $preserved = @(Get-AdProp (Get-AdProp $Spec 'preserve' $null) 'paths' @() | ForEach-Object { [string]$_ })
  $sha = [Security.Cryptography.SHA256]::Create()
  $print = @($targetViews | ForEach-Object { $_.file.content }) -join "`n"
  return [ordered]@{
    specId = [string]$Spec.id; displayName = [string]$Spec.displayName; request = $req
    ok = ($blockers.Count -eq 0); blockers = @($blockers.ToArray()); warnings = @($warnings.ToArray())
    backends = @($backendViews.ToArray()); targets = @($targetViews.ToArray()); networkChanges = @($networkChanges.ToArray())
    preserved = $preserved; cloudflareNeeded = [bool]($roles -contains 'external')
    fingerprint = [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($print))).Replace('-', '')
  }
}

# Reads this PC: the adoption files already on disk, for the plan's create / unchanged / update.
function Get-ExistingAdoptionFiles([string]$Id, $Targets) {
  $map = @{}
  foreach ($role in 'external', 'internal') {
    $t = $Targets[$role]
    if (-not $t.settings) { continue }
    $name = Get-AdoptionFileName $Id $role
    $path = Join-Path $t.settings.DynamicDir $name
    if (Test-Path -LiteralPath $path) { $map["$role/$name"] = [IO.File]::ReadAllText($path) }
  }
  return $map
}

# --- Wizard state -----------------------------------------------------------------------------------------------------------

function Read-AdoptionState($Settings, [string]$Id) {
  $path = Join-Path (Get-AdoptionRoot $Settings $Id) 'state.json'
  if (-not (Test-Path -LiteralPath $path)) { return $null }
  return ([IO.File]::ReadAllText($path) | ConvertFrom-Json)
}

function Save-AdoptionState($Settings, [string]$Id, $State) {
  $root = Get-AdoptionRoot $Settings $Id
  New-Item -ItemType Directory -Force -Path $root | Out-Null
  Write-TextFileAtomic (Join-Path $root 'state.json') ((ConvertTo-Json -InputObject $State -Depth 12) + "`n")
}

function New-AdoptionState([string]$Id, $Spec, $Request) {
  return [pscustomobject][ordered]@{ id = $Id; spec = $Spec; request = $Request; phase = 'previewed'; attachedNetworks = @(); files = @(); snapshot = ''; cloudflare = [pscustomobject]@{ created = @(); manualReversal = @(); fingerprint = '' }; checks = @(); history = @() }
}

function Add-AdoptionHistory($State, [string]$Event, [string]$Detail = '') {
  $State.history = @(@($State.history) + [pscustomobject]@{ at = (Get-Date -Format 's'); event = $Event; detail = $Detail })
}

# --- Step 4: reachability from the proxy's network (reads this PC; disposable probe containers) ------------------------------

function Invoke-ProxyNetworkProbe {
  param([Parameter(Mandatory = $true)][string]$Network, [Parameter(Mandatory = $true)][string]$Url, [Parameter(Mandatory = $true)][string]$Image, [string]$NamePrefix = 'dtc')
  $name = "$NamePrefix-validate-probe-$([Guid]::NewGuid().ToString('N').Substring(0, 8))"
  $probeArgs = @('run', '--rm', '--pull', 'never', '--name', $name, '--network', $Network, '--read-only', '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges', '--memory', '32m', '--label', 'org.traefik-proxy.probe=1', '--entrypoint', 'wget', $Image, '-S', '-q', '-O', '/dev/null', '-T', '4')
  if ($Url -like 'https:*') { $probeArgs += '--no-check-certificate' }
  $probeArgs += $Url
  $r = Invoke-Docker @probeArgs
  return (ConvertFrom-ProbeOutput $r.Output $r.ExitCode)
}

function New-AdoptionCheck([string]$Kind, [string]$Role, [string]$Subject, [string]$State, [string]$Detail) {
  return [ordered]@{ kind = $Kind; role = $Role; subject = $Subject; state = $State; detail = $Detail }
}

# Is every backend reachable from each proxy's network? A container that is not attached yet is reported as such, with whether
# it answers on its own network: that is a pending change, not a broken application.
function Invoke-AdoptionReachability {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Plan, [Parameter(Mandatory = $true)]$Facts)
  $checks = New-Object System.Collections.ArrayList
  foreach ($t in @($Plan.targets)) {
    if ($t.proxyMode -eq 'absent') { continue }
    foreach ($b in @($Plan.backends)) {
      if (-not @($t.routers | Where-Object { $_.backend -eq $b.id }).Count) { continue }
      $url = "$(@($t.routers | Where-Object { $_.backend -eq $b.id })[0].url)$($b.healthPath)"
      $subject = "$($b.id) from $($t.proxy)"
      if ($b.kind -eq 'container' -and $b.state -ne 'running') { $null = $checks.Add((New-AdoptionCheck 'backend' $t.role $subject 'failed' "$($b.container) is $($b.state).")); continue }
      if ($b.kind -eq 'container' -and @($b.networks) -notcontains $t.network) {
        $c = @($Facts.containers | Where-Object { $_.name -eq $b.container })[0]
        $own = Test-ContainerPort -Container $c -Port $b.port -ProxyNetwork '' -Image $Settings.TraefikImage -NamePrefix $Settings.StackName -Schemes @($b.protocol)
        $answers = $own.result -in 'http', 'https'
        $null = $checks.Add((New-AdoptionCheck 'backend' $t.role $subject $(if ($answers) { 'pending' } else { 'failed' }) "Not on $($t.network) yet (the preview attaches it). On its own network: $($own.detail)"))
        continue
      }
      $p = Invoke-ProxyNetworkProbe -Network $t.network -Url $url -Image $Settings.TraefikImage -NamePrefix $Settings.StackName
      $null = $checks.Add((New-AdoptionCheck 'backend' $t.role $subject $(if ($p.result -eq 'http') { 'ok' } else { 'failed' }) "$url : $($p.detail)"))
    }
  }
  return @($checks.ToArray())
}

# --- Step 5: prepared files, validated in a throwaway Traefik; nothing is loaded by a running proxy ---------------------------

function Invoke-AdoptionPrepare {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Plan, [Parameter(Mandatory = $true)]$Facts)
  $dir = Join-Path (Get-AdoptionRoot $Settings $Plan.specId) 'prepared'
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  $results = @()
  foreach ($t in @($Plan.targets)) {
    Write-TextFileAtomic (Join-Path $dir $t.file.name) $t.file.content
    if ($t.proxyMode -eq 'lan-entrypoint') { $results += New-AdoptionCheck 'config' $t.role $t.file.name 'unverified' 'The throwaway validator has no LAN entry point; Traefik checks this file when it is activated.'; continue }
    $target = $Facts.targets[$t.role]
    $expect = @($t.routers | ForEach-Object { "$($_.name)@file" })
    $v = Test-TraefikDynamicConfig -Settings $target.settings -ExtraFiles @{ ($t.file.name) = $t.file.content } -ExpectRouters $expect
    $results += New-AdoptionCheck 'config' $t.role $t.file.name $(if ($v.Ok) { 'ok' } else { 'failed' }) $(if ($v.Ok) { "$($expect.Count) router(s) accepted by a throwaway Traefik." } else { @($v.Errors) -join ' | ' })
  }
  return $results
}

# --- Step 6: activate on the proxies. This moves no traffic: only Cloudflare or LAN DNS send visitors to these routers --------

function Wait-AdoptionRouters($TargetSettings, [string[]]$Names, [int]$TimeoutSeconds = 20) {
  $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
  do {
    $routers = Get-TraefikApi -Settings $TargetSettings -Path '/api/http/routers'
    if ($routers) {
      $loaded = @($routers | ForEach-Object { $_.name })
      if (@($Names | Where-Object { $loaded -notcontains $_ }).Count -eq 0) { return $true }
    }
    Start-Sleep -Milliseconds 700
  } while ((Get-Date) -lt $deadline)
  return $false
}

function Invoke-AdoptionActivate {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Plan, [Parameter(Mandatory = $true)]$Facts, [Parameter(Mandatory = $true)]$State)
  if (-not $Plan.ok) { throw 'The preview has blocking problems; nothing was changed.' }
  $steps = New-Object System.Collections.ArrayList
  $root = Get-AdoptionRoot $Settings $Plan.specId
  # Previous versions of the route files come back on rollback, so that a re-adoption rolls back to its previous state.
  if (-not $State.snapshot) {
    $snap = Join-Path $root "snapshots\$(Get-Date -Format 'yyyyMMdd-HHmmss-fff')"
    New-Item -ItemType Directory -Force -Path $snap | Out-Null
    foreach ($t in @($Plan.targets)) {
      $dest = Join-Path $Facts.targets[$t.role].settings.DynamicDir $t.file.name
      if (Test-Path -LiteralPath $dest) { Copy-Item -LiteralPath $dest -Destination (Join-Path $snap "$($t.role).yml") }
    }
    $State.snapshot = Split-Path -Leaf $snap
  }
  foreach ($n in @($Plan.networkChanges)) {
    $r = Invoke-Docker network connect $n.network $n.container
    # Recorded only when this run attached it: a rollback must not detach what was already there.
    if ($r.ExitCode -eq 0) { $State.attachedNetworks = @(@($State.attachedNetworks) + [pscustomobject]@{ container = $n.container; network = $n.network }) }
    elseif ((@($r.Output) -join ' ') -notmatch 'already exists') { throw "docker network connect $($n.network) $($n.container) failed: $((@($r.Output) -join ' ').Trim())" }
    $null = $steps.Add([ordered]@{ name = "Attach $($n.container) to $($n.network)"; status = 'Done'; message = 'Live change; the container keeps running.' })
  }
  $files = New-Object System.Collections.ArrayList
  foreach ($t in @($Plan.targets)) {
    $target = $Facts.targets[$t.role]
    $dest = Join-Path $target.settings.DynamicDir $t.file.name
    if ($t.file.action -ne 'unchanged') { Write-TextFileAtomic $dest $t.file.content }
    $null = $files.Add([pscustomobject]@{ role = $t.role; path = $dest; sha256 = (Get-TextSha256 $t.file.content) })
    $warn = Sync-TraefikDynamic -Settings $target.settings
    $loaded = $(if ($t.proxyMode -eq 'absent') { $false } else { Wait-AdoptionRouters $target.settings @($t.routers | ForEach-Object { "$($_.name)@file" }) })
    $null = $steps.Add([ordered]@{ name = "Load $($t.file.name) on $($t.proxy)"; status = $(if ($loaded) { 'Done' } else { 'Warning' }); message = $(if ($warn) { $warn } elseif ($loaded) { 'Every router is loaded.' } else { 'Traefik has not reported the routers yet.' }) })
  }
  $State.files = @($files.ToArray())
  return @($steps.ToArray())
}

# --- Tests through the proxy, by Host header: no public traffic, no DNS -------------------------------------------------------

# Upgrade request; 101 means the WebSocket reached the application. Needs a path that speaks WebSocket.
function Test-WebSocketUpgrade([int]$Port, [string]$HostHeader, [string]$Path) {
  $c = New-Object System.Net.Sockets.TcpClient
  try {
    $c.ReceiveTimeout = 6000; $c.SendTimeout = 6000
    $c.Connect('127.0.0.1', $Port)
    $s = $c.GetStream()
    $key = [Convert]::ToBase64String([Guid]::NewGuid().ToByteArray())
    $text = "GET $Path HTTP/1.1`r`nHost: $HostHeader`r`nConnection: Upgrade`r`nUpgrade: websocket`r`nSec-WebSocket-Version: 13`r`nSec-WebSocket-Key: $key`r`n`r`n"
    $b = [Text.Encoding]::ASCII.GetBytes($text)
    $s.Write($b, 0, $b.Length)
    $buf = New-Object byte[] 256
    $n = $s.Read($buf, 0, 256)
    if ($n -gt 0 -and ([Text.Encoding]::ASCII.GetString($buf, 0, $n)) -match '^HTTP/1\.1 (\d{3})') { return [int]$Matches[1] }
    return 0
  } catch { return 0 } finally { $c.Close() }
}

# Pure: what one anonymous request through a route says. External + sign-in must not reach the application.
function ConvertTo-RouteVerdict([int]$Status, [string]$Location, [bool]$SignIn) {
  if ($Status -eq 0) { return @{ route = 'failed'; auth = $(if ($SignIn) { 'unverified' } else { 'n/a' }); detail = 'No HTTP answer from the proxy.' } }
  if ($Status -eq 404) { return @{ route = 'failed'; auth = $(if ($SignIn) { 'unverified' } else { 'n/a' }); detail = 'Traefik answered 404: this route is not loaded, or the application has nothing at that path.' } }
  if ($SignIn) {
    if ($Status -in 301, 302, 303, 307, 308, 401, 403) { return @{ route = 'ok'; auth = 'ok'; detail = "Sign-in enforced (HTTP $Status$(if ($Location) { " to $Location" }))." } }
    if ($Status -ge 500) { return @{ route = 'failed'; auth = 'failed'; detail = "HTTP ${Status}: Traefik could not get an answer from authentik, so the request is refused." } }
    return @{ route = 'ok'; auth = 'failed'; detail = "HTTP ${Status}: an anonymous request reached the application. It is NOT protected." }
  }
  if ($Status -in 502, 503, 504) { return @{ route = 'failed'; auth = 'n/a'; detail = "HTTP ${Status}: Traefik cannot reach the backend." } }
  return @{ route = 'ok'; auth = 'n/a'; detail = "The route answers (HTTP $Status)." }
}

# Reads this PC; anonymous GET requests only, against the local proxies.
function Invoke-AdoptionTests {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Plan, [Parameter(Mandatory = $true)]$Facts)
  $checks = New-Object System.Collections.ArrayList
  $checks.AddRange(@(Invoke-AdoptionReachability -Settings $Settings -Plan $Plan -Facts $Facts))
  foreach ($t in @($Plan.targets)) {
    $target = $Facts.targets[$t.role]
    if ($t.proxyMode -eq 'lan-entrypoint') { $null = $checks.Add((New-AdoptionCheck 'route' $t.role $t.hostname 'unverified' 'The LAN entry point cannot be tested from this loopback address. Test it from a LAN client.')); continue }
    $live = @(Get-TraefikApi -Settings $target.settings -Path '/api/http/routers' | Where-Object { $_ } | ForEach-Object { $_.name })
    foreach ($r in @($t.routers)) {
      $loaded = $live -contains "$($r.name)@file"
      $null = $checks.Add((New-AdoptionCheck 'router' $t.role $r.name $(if ($loaded) { 'ok' } else { 'failed' }) $(if ($loaded) { "$($r.rule) priority $($r.priority)" } else { 'Not loaded by Traefik.' })))
      if (-not $loaded) { continue }
      $url = "http://127.0.0.1:$($target.settings.HttpPort)$(if ($r.path) { $r.path } else { '/' })"
      $res = Invoke-ProbeRequest -Url $url -HostHeader $t.hostname
      $v = ConvertTo-RouteVerdict ([int]$res.Status) ([string]$res.Location) ([bool]$r.signIn)
      $null = $checks.Add((New-AdoptionCheck 'route' $t.role "$($t.hostname)$($r.path)" $v.route $v.detail))
      if ($r.signIn) { $null = $checks.Add((New-AdoptionCheck 'auth' $t.role "$($t.hostname)$($r.path)" $v.auth $v.detail)) }
      if ($r.websocket) {
        if (-not $r.websocketTestPath) { $null = $checks.Add((New-AdoptionCheck 'websocket' $t.role $r.name 'unverified' 'Traefik passes WebSocket upgrades; the specification names no path to test.')) }
        elseif ($r.signIn) { $null = $checks.Add((New-AdoptionCheck 'websocket' $t.role $r.name 'unverified' 'Needs a signed-in session; test it in a browser.')) }
        else {
          $code = Test-WebSocketUpgrade $target.settings.HttpPort $t.hostname $r.websocketTestPath
          $null = $checks.Add((New-AdoptionCheck 'websocket' $t.role $r.name $(if ($code -eq 101) { 'ok' } else { 'failed' }) "Upgrade on $($r.websocketTestPath) answered $code."))
        }
      }
    }
    # An internal name must not answer on the public proxy, and the other way round.
    $otherRole = $(if ($t.role -eq 'external') { 'internal' } else { 'external' })
    $other = $Facts.targets[$otherRole]
    if ($other.settings -and $other.running -and $other.mode -eq 'stack') {
      $res = Invoke-ProbeRequest -Url "http://127.0.0.1:$($other.settings.HttpPort)/" -HostHeader $t.hostname
      $sep = [int]$res.Status -eq 404
      $null = $checks.Add((New-AdoptionCheck 'separation' $t.role "$($t.hostname) on $($other.name)" $(if ($sep) { 'ok' } else { 'failed' }) "The $otherRole proxy answered HTTP $($res.Status) for this $($t.role) hostname."))
    }
  }
  return @($checks.ToArray())
}

# A backend that is not attached yet is 'pending'; the rest of the check list decides whether the migration may continue.
function Test-ChecksPassed($Checks) { return (@(@($Checks) | Where-Object { $_.state -in 'failed', 'pending' }).Count -eq 0) }

# --- Step 7-8: Cloudflare, reusing the registry's plan and execution ----------------------------------------------------------

function Get-AdoptionPseudoService($Spec, $Request, [bool]$Access = $false) {
  return ConvertTo-ServiceDefinition ([pscustomobject]@{ name = "adopt-$($Spec.id)"; hostnames = @($Request.externalHost); target = [pscustomobject]@{ type = 'docker'; host = 'traefik'; port = 80; protocol = 'http' }; cloudflare = [pscustomobject]@{ publish = $true; access = $Access } })
}

# Reads Cloudflare (GET only). Internal hostnames are never passed in: only the external name can reach the API.
function Get-AdoptionCloudflarePlan {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Spec, [Parameter(Mandatory = $true)]$Request, $Services = @())
  $req = ConvertTo-AdoptionRequest $Request
  if (@(Get-RequestRoles $req) -notcontains 'external') { return $null }
  return (Get-CloudflareServicePlan -Settings $Settings -Service (Get-AdoptionPseudoService $Spec $req) -OtherServices $Services)
}

function ConvertTo-CloudflarePlanView($Plan) {
  if (-not $Plan) { return [ordered]@{ needed = $false; connected = $false; actions = @(); notes = @('This routing does not use Cloudflare.'); errors = @(); manualSteps = @(); fingerprint = '' } }
  return [ordered]@{ needed = $true; connected = [bool]$Plan.Connected
    actions = @(@($Plan.Actions) | ForEach-Object { [ordered]@{ id = [string]$_.Id; step = [string]$_.Step; kind = [string]$_.Kind; hostname = [string]$_.Hostname; summary = [string]$_.Summary; detail = [string]$_.Detail; overwrite = [bool]$_.Overwrite } })
    notes = @($Plan.Notes); errors = @($Plan.Errors); manualSteps = @($Plan.ManualSteps); fingerprint = [string]$Plan.Fingerprint }
}

# Pure: which reversals a rollback can do itself (what this run created) and which need a person (what it replaced).
function Get-CloudflareReversal($Plan, $Results) {
  $created = New-Object System.Collections.ArrayList
  $manual = New-Object System.Collections.ArrayList
  foreach ($a in @($Plan.Actions)) {
    $res = @(@($Results) | Where-Object { $_.Id -eq $a.Id })
    if (-not $res.Count -or $res[0].Status -ne 'Done') { continue }
    if ($a.Kind -eq 'create') { $null = $created.Add([pscustomobject]@{ step = [string]$a.Step; hostname = [string]$a.Hostname }) }
    elseif ($a.Kind -eq 'update') { $null = $manual.Add("Cloudflare: this cutover changed: $($a.Summary). Restore the previous value in the Cloudflare dashboard to undo it.") }
  }
  return [pscustomobject]@{ created = @($created.ToArray()); manual = @($manual.ToArray()) }
}

# Undoes only what this adoption created. Replaced records stay as they are, listed for a person: their previous values were
# someone else's and are not restored from memory.
function Invoke-CloudflareReversal {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$Spec, [Parameter(Mandatory = $true)]$Request, [Parameter(Mandatory = $true)]$Created, $Services = @())
  if (-not @($Created).Count) { return @() }
  $previous = Get-AdoptionPseudoService $Spec (ConvertTo-AdoptionRequest $Request)
  $plan = Get-CloudflareServicePlan -Settings $Settings -PreviousService $previous -OtherServices $Services -Cleanup
  $allowed = @(@($Created) | ForEach-Object { "$($_.step)|$($_.hostname)" })
  $plan.Actions = @(@($plan.Actions) | Where-Object { $allowed -contains "$($_.Step)|$($_.Hostname)" })
  return @(Invoke-CloudflareServicePlan -Settings $Settings -Plan $plan -ServiceName $previous.name)
}

# --- Step 9: public checks, each with its own state ---------------------------------------------------------------------------

# Pure: public DNS answer + one anonymous HTTPS answer -> separate DNS, TLS, proxy and sign-in states.
function ConvertTo-PublicChecks {
  param([string]$Hostname, [string[]]$DnsAnswers = @(), [int]$Status = 0, [string]$Location = '', [string]$ErrorText = '', [bool]$SignIn = $true)
  $checks = New-Object System.Collections.ArrayList
  $hasDns = @($DnsAnswers).Count -gt 0
  $null = $checks.Add((New-AdoptionCheck 'dns' 'external' $Hostname $(if ($hasDns) { 'ok' } else { 'failed' }) $(if ($hasDns) { "Resolves to $(@($DnsAnswers) -join ', ')." } else { 'Does not resolve in public DNS.' })))
  if (-not $hasDns) { return @($checks.ToArray()) }
  if ($Status -eq 0) {
    $tls = $ErrorText -match '(?i)ssl|tls|certificate|trust'
    $null = $checks.Add((New-AdoptionCheck 'tls' 'external' $Hostname $(if ($tls) { 'failed' } else { 'unverified' }) $(if ($ErrorText) { $ErrorText } else { 'No answer.' })))
    $null = $checks.Add((New-AdoptionCheck 'public' 'external' $Hostname 'failed' 'No HTTPS answer through Cloudflare.'))
    return @($checks.ToArray())
  }
  $null = $checks.Add((New-AdoptionCheck 'tls' 'external' $Hostname 'ok' 'The HTTPS connection succeeded.'))
  $edge = $Status -in 502, 503, 504, 520, 521, 522, 523, 524, 525, 526, 530
  $null = $checks.Add((New-AdoptionCheck 'public' 'external' $Hostname $(if ($edge -or $Status -eq 404) { 'failed' } else { 'ok' }) $(if ($Status -eq 530) { 'HTTP 530: Cloudflare cannot reach a tunnel for this hostname.' } elseif ($edge) { "HTTP ${Status}: the request did not reach the application." } elseif ($Status -eq 404) { 'HTTP 404: the tunnel has no route, or Traefik has no router for it.' } else { "HTTP $Status through Cloudflare." })))
  if ($SignIn -and -not $edge -and $Status -ne 404) {
    $redir = $Status -in 301, 302, 303, 307, 308, 401, 403
    $null = $checks.Add((New-AdoptionCheck 'auth' 'external' $Hostname $(if ($redir) { 'ok' } else { 'failed' }) $(if ($redir) { "An anonymous visitor is sent to sign-in (HTTP $Status$(if ($Location) { " to $Location" }))." } else { "HTTP ${Status}: an anonymous visitor reached the application." })))
  }
  return @($checks.ToArray())
}

# Reads the Internet: one DNS query at a public resolver and one anonymous HTTPS request.
function Invoke-AdoptionPublicChecks([string]$Hostname, [bool]$SignIn = $true) {
  $answers = @()
  try { $answers = @(Resolve-DnsName -Name $Hostname -Server '1.1.1.1' -DnsOnly -ErrorAction Stop | Where-Object { $_.PSObject.Properties['IPAddress'] -and $_.IPAddress } | ForEach-Object { [string]$_.IPAddress }) } catch { }
  $res = $null
  if ($answers.Count) { $res = Invoke-ProbeRequest -Url "https://$Hostname/" }
  return @(ConvertTo-PublicChecks -Hostname $Hostname -DnsAnswers $answers -Status $(if ($res) { [int]$res.Status } else { 0 }) -Location $(if ($res) { [string]$res.Location } else { '' }) -ErrorText $(if ($res) { [string]$res.Error } else { '' }) -SignIn $SignIn)
}

# --- Rollback and drift -----------------------------------------------------------------------------------------------------

# Removes the adoption's route files (or restores the versions they replaced) and detaches only the networks it attached.
function Invoke-AdoptionLocalRollback {
  param([Parameter(Mandatory = $true)]$Settings, [Parameter(Mandatory = $true)]$State, [Parameter(Mandatory = $true)]$Targets)
  $steps = New-Object System.Collections.ArrayList
  $snapDir = $(if ($State.snapshot) { Join-Path (Get-AdoptionRoot $Settings $State.id) "snapshots\$($State.snapshot)" } else { '' })
  foreach ($f in @($State.files)) {
    $saved = $(if ($snapDir) { Join-Path $snapDir "$($f.role).yml" } else { '' })
    if ($saved -and (Test-Path -LiteralPath $saved)) {
      Copy-Item -LiteralPath $saved -Destination $f.path -Force
      $null = $steps.Add([ordered]@{ name = "Restore $(Split-Path -Leaf $f.path)"; status = 'Done'; message = 'Previous version restored.' })
    } elseif (Test-Path -LiteralPath $f.path) {
      $content = [IO.File]::ReadAllText($f.path)
      if (-not $content.StartsWith($script:GeneratedHeader)) { $null = $steps.Add([ordered]@{ name = "Remove $(Split-Path -Leaf $f.path)"; status = 'Skipped'; message = 'Not generated by this workflow; left alone.' }); continue }
      Remove-Item -LiteralPath $f.path -Force
      $null = $steps.Add([ordered]@{ name = "Remove $(Split-Path -Leaf $f.path)"; status = 'Done'; message = '' })
    }
    $target = $Targets[[string]$f.role]
    if ($target.settings) {
      $warn = Sync-TraefikDynamic -Settings $target.settings
      if ($warn) { $null = $steps.Add([ordered]@{ name = 'Traefik reload'; status = 'Warning'; message = $warn }) }
    }
  }
  foreach ($n in @($State.attachedNetworks)) {
    $r = Invoke-Docker network disconnect $n.network $n.container
    $null = $steps.Add([ordered]@{ name = "Detach $($n.container) from $($n.network)"; status = $(if ($r.ExitCode -eq 0) { 'Done' } else { 'Warning' }); message = $(if ($r.ExitCode -eq 0) { 'Live change; the container keeps running.' } else { (@($r.Output) -join ' ').Trim() }) })
  }
  $State.files = @(); $State.attachedNetworks = @(); $State.snapshot = ''
  return @($steps.ToArray())
}

# Pure: adopted routes depend on state that can drift when a container is recreated from its own definition.
function Get-AdoptionDrift($State, $Containers) {
  $drift = New-Object System.Collections.ArrayList
  foreach ($n in @($State.attachedNetworks)) {
    $c = @(@($Containers) | Where-Object { $_.name -eq $n.container })
    if (-not $c.Count) { $null = $drift.Add([ordered]@{ kind = 'container-missing'; container = [string]$n.container; network = [string]$n.network; detail = "$($n.container) no longer exists." }) }
    elseif (-not @($c[0].networks | Where-Object { $_.name -eq $n.network }).Count) { $null = $drift.Add([ordered]@{ kind = 'network-lost'; container = [string]$n.container; network = [string]$n.network; detail = "$($n.container) lost $($n.network) (it was probably recreated). Its route answers 502/504 until it is attached again; add the network to its definition to keep it." }) }
  }
  foreach ($f in @($State.files)) {
    if (-not (Test-Path -LiteralPath $f.path)) { $null = $drift.Add([ordered]@{ kind = 'file-missing'; container = ''; network = ''; detail = "$(Split-Path -Leaf $f.path) was removed." }) }
    elseif ((Get-FileSha256 $f.path) -ne $f.sha256) { $null = $drift.Add([ordered]@{ kind = 'file-changed'; container = ''; network = ''; detail = "$(Split-Path -Leaf $f.path) was edited by hand." }) }
  }
  return @($drift.ToArray())
}

# --- Step 10: retirement. Only proxy infrastructure; stopping and deleting are separate actions -------------------------------

# Pure. Volumes are not candidates at all. Application containers, this deployment's stacks and networks still in use are blocked.
function Get-AdoptionRetirePlan {
  param([Parameter(Mandatory = $true)]$Spec, [Parameter(Mandatory = $true)]$Facts, [string[]]$OwnStacks = @(), [string[]]$OwnNetworks = @())
  $projects = @(Get-AdProp (Get-AdProp $Spec 'legacy' $null) 'composeProjects' @() | ForEach-Object { [string]$_ })
  $backendContainers = @(foreach ($b in @($Spec.backends | Where-Object { $_.kind -eq 'container' })) { @(Find-BackendMatches $b $Facts.containers | ForEach-Object { [string]$_.name }) })
  $items = New-Object System.Collections.ArrayList
  foreach ($c in @($Facts.containers)) {
    $project = [string]$c.compose.project
    if ($projects -notcontains $project) { continue }
    $blocked = ''
    if ($OwnStacks -contains $project) { $blocked = 'Part of this deployment.' }
    elseif ($backendContainers -contains [string]$c.name) { $blocked = 'An application backend. Never retired.' }
    elseif (-not $c.infrastructure) { $blocked = 'Not a proxy or tunnel container.' }
    $null = $items.Add([ordered]@{ type = 'container'; name = [string]$c.name; state = [string]$c.state; project = $project; blocked = $blocked; detail = '' })
  }
  foreach ($n in @(Get-AdProp $Facts 'networks' @())) {
    $project = [string](Get-AdProp $n 'project' '')
    if ($projects -notcontains $project) { continue }
    $attached = @(Get-AdProp $n 'containers' @())
    $blocked = ''
    if ($OwnStacks -contains $project -or $OwnNetworks -contains [string]$n.name) { $blocked = 'Part of this deployment.' }
    elseif (@($attached | Where-Object { $_ -notmatch "^$([regex]::Escape($project))[-_]" }).Count) { $blocked = "Still used by: $(@($attached) -join ', ')." }
    $null = $items.Add([ordered]@{ type = 'network'; name = [string]$n.name; state = $(if ($attached.Count) { 'in use' } else { 'unused' }); project = $project; blocked = $blocked; detail = '' })
  }
  return [ordered]@{ items = @($items.ToArray()); neverTouched = 'Volumes, model folders, databases and application containers are never candidates.' }
}

# Changes this PC. 'stop' stops proxy containers and can be undone with docker start; 'delete' removes stopped containers and
# unused networks and cannot. No volume is ever passed to Docker, and `docker rm` runs without -v.
function Invoke-AdoptionRetire {
  param([Parameter(Mandatory = $true)]$RetirePlan, [Parameter(Mandatory = $true)][ValidateSet('stop', 'delete')][string]$Action, [Parameter(Mandatory = $true)][string[]]$Names)
  $results = New-Object System.Collections.ArrayList
  foreach ($name in $Names) {
    $item = @(@($RetirePlan.items) | Where-Object { $_.name -eq $name })
    if (-not $item.Count) { $null = $results.Add([ordered]@{ name = $name; status = 'Refused'; message = 'Not a retirement candidate.' }); continue }
    $i = $item[0]
    if ($i.blocked) { $null = $results.Add([ordered]@{ name = $name; status = 'Refused'; message = $i.blocked }); continue }
    if ($Action -eq 'stop') {
      if ($i.type -ne 'container') { $null = $results.Add([ordered]@{ name = $name; status = 'Refused'; message = 'Only containers can be stopped.' }); continue }
      $r = Invoke-Docker stop $name
    } elseif ($i.type -eq 'container') {
      if ($i.state -eq 'running') { $null = $results.Add([ordered]@{ name = $name; status = 'Refused'; message = 'Stop it first, and check that everything still works.' }); continue }
      $r = Invoke-Docker rm $name
    } else {
      $r = Invoke-Docker network rm $name
    }
    $null = $results.Add([ordered]@{ name = $name; status = $(if ($r.ExitCode -eq 0) { 'Done' } else { 'Failed' }); message = $(if ($r.ExitCode -eq 0) { '' } else { (@($r.Output) -join ' ').Trim() }) })
  }
  return @($results.ToArray())
}

