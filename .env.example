# Copied to .env by install.ps1. Contains no secrets: the tunnel token lives in
# secrets\cloudflare_tunnel_token (install.ps1 -SetTunnelToken), which is git-ignored.
#
# Every value here is instance-specific. To run a second, independent instance on the same PC, install it
# into another folder (-InstallPath) with a different STACK_NAME, ports, PROXY_NETWORK and tunnel subnet.

# Compose project name and container name prefix (<STACK_NAME>-traefik, <STACK_NAME>-cloudflared, ...).
STACK_NAME=traefik-proxy

# Loopback-only host ports (127.0.0.1). Change if they collide with something else on this PC.
TRAEFIK_HTTP_PORT=8180
TRAEFIK_DASHBOARD_PORT=8181

# Shared Docker network that application containers join so Traefik can reach them by container name.
# Created by install.ps1 if missing; reused (never recreated) if it exists.
PROXY_NETWORK=proxy

# Private network between cloudflared and Traefik. CLOUDFLARED_IP must be inside TUNNEL_SUBNET and outside
# TUNNEL_IP_RANGE; it is the only address Traefik trusts for X-Forwarded-* headers.
TUNNEL_SUBNET=172.31.250.0/28
TUNNEL_IP_RANGE=172.31.250.0/29
CLOUDFLARED_IP=172.31.250.10

# Traefik log level (DEBUG, INFO, WARN, ERROR) and the read timeout for slow uploads.
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_READ_TIMEOUT=300s
